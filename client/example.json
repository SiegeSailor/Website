  "description": "UI components for the ATLAS-Linux platform.",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.es.js",
      "require": "./dist/client.umd.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.es.js",
      "require": "./dist/server.umd.js"
    },
    "./index.css": "./dist/index.css",
    "./*": "./dist/*"
  },
  "files": ["./dist/**/*"],
  "homepage": "https://gitlab.com/csi-engineering/csi-platform/vista-design",
  "lint-staged": {
    "**/*": ["prettier --check --ignore-unknown", "ls-lint"],
    "./source/**/*.{css,sass,scss}": ["stylelint"],
    "./.ladle/components.scss": ["stylelint"],
    "./source/**/*.{js,jsx,ts,tsx,d.ts}": ["sh -c 'tsc'", "eslint", "jest"]
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "name": "@csi-engineering/vista-design",
  "type": "module",
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "private": false,
  "publishConfig": {
    "@csi-engineering:registry": "https://gitlab.com/api/v4/projects/71558203/packages/npm/"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:csi-engineering/csi-platform/vista-design.git"
  },
  "scripts": {
    "prepare": "node './.husky/install.mjs'",
    "serve": "ladle serve",
    "ci:validate-format": "prettier --check --ignore-unknown *",
    "ci:validate-types": "tsc",
    "ci:lint-file-system": "ls-lint",
    "ci:lint-code": "eslint './source/' --ext '.js,.jsx,.ts,.tsx,.d.ts'",
    "ci:lint-style": "stylelint './source/**/*.{css,sass,scss}' './.ladle/components.scss'",
    "ci:run-unit-tests": "jest",
    "ci:build-vite": "NODE_ENV=production vite build",
    "preci:build-ladle": "rm -f ./.env && touch ./.env && echo \"VITE_CI_COMMIT_REF_NAME=${CI_COMMIT_REF_NAME}\" >> ./.env && echo \"VITE_CI_COMMIT_SHORT_SHA=${CI_COMMIT_SHORT_SHA}\" >> ./.env",
    "ci:build-ladle": "NODE_ENV=production ladle build",
    "ci:publish-registry-release": "npx --yes --package semantic-release@24.2.9 --package @semantic-release/exec@7.1.0 --package @semantic-release/gitlab@13.2.9 --package conventional-changelog-conventionalcommits@7.0.2 semantic-release",
    "ci:create-deploy-pages-release": "node ./.gitlab/create-deploy-pages-release.js"
  },
  "version": "1.3.0"
}
