{
  "name": "@siegesailor-website/root",
  "version": "2.0.3",
  "description": "SiegeSailor's personal website.",
  "homepage": "https://github.com/SiegeSailor/Website",
  "bugs": "https://github.com/SiegeSailor/Website/issues",
  "private": true,
  "type": "module",
  "workspaces": [
    "source"
  ],
  "engines": {
    "node": ">= 26.5.0",
    "npm": ">= 11.17.0"
  },
  "scripts": {
    "prepare": "if command -v husky > /dev/null; then husky; fi",
    "build": "npm run build --workspace source",
    "watch": "npm run watch --workspace source",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace source",
    "lint:fix": "npm run lint:fix --workspace source",
    "typecheck": "npm run typecheck --workspace source"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "conventional-changelog-conventionalcommits": "10.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.4",
    "semantic-release": "25.0.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "@heroui/shared-utils@2.1.12": true,
    "unrs-resolver@1.12.2": true
  }
}
