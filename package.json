{
  "name": "@siegesailor-website/root",
  "version": "1.2.0",
  "description": "SiegeSailor's personal website, resume documents, and GitHub profile README.",
  "homepage": "https://github.com/SiegeSailor/Website",
  "bugs": "https://github.com/SiegeSailor/Website/issues",
  "private": true,
  "type": "module",
  "workspaces": [
    "source/website",
    "source/tooling"
  ],
  "engines": {
    "node": ">= 26.5.0",
    "npm": ">= 11.17.0"
  },
  "scripts": {
    "prepare": "if command -v husky > /dev/null; then husky; fi",
    "build": "npm run build:versions && npm run build:readme && npm run build:resume && npm run build:website",
    "build:readme": "npm run build:readme --workspace source/tooling",
    "build:resume": "npm run build:resume --workspace source/tooling",
    "build:versions": "npm run build:versions --workspace source/tooling",
    "build:website": "npm run build --workspace source/website",
    "watch": "bash scripts/run-parallel.sh watch:readme watch:resume watch:website",
    "watch:readme": "npm run watch:readme --workspace source/tooling",
    "watch:resume": "npm run watch:resume --workspace source/tooling",
    "watch:website": "npm run watch --workspace source/website",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace source/website",
    "lint:fix": "npm run lint:fix --workspace source/website",
    "typecheck": "npm run typecheck --workspace source/website"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "conventional-changelog-conventionalcommits": "10.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.4",
    "semantic-release": "25.0.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "@heroui/shared-utils@2.1.12": true,
    "unrs-resolver@1.12.2": true
  }
}
